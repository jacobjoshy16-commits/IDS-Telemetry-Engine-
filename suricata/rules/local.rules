# Local signatures are context signals; behavioral scoring remains in the Python engine.
alert dns $HOME_NET any -> any 53 (msg:"LOCAL Possible encoded DNS tunnel label"; flow:to_server; dns.query; pcre:"/^[A-Za-z0-9+\/=]{32,}\./"; classtype:bad-unknown; sid:9000001; rev:1; metadata:mitre_tactic_id TA0011, mitre_technique_id T1071.004, nist_control SI-4;)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"LOCAL TLS connection using uncommon server name shape"; flow:established,to_server; tls.sni; pcre:"/^[A-Fa-f0-9]{32,}\./"; classtype:trojan-activity; sid:9000002; rev:1; metadata:mitre_tactic_id TA0011, mitre_technique_id T1071.001, nist_control SC-7;)
