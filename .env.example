# Copy to .env for local non-Compose operation. Never commit credentials.
IDS_SERVICE_NAME=ids-telemetry-engine
IDS_SENSOR_ID=correlator-01
IDS_LOG_LEVEL=INFO
IDS_QUEUE_SIZE=20000

IDS_SOURCE__SURICATA_PATH=/var/log/suricata/eve.json
IDS_SOURCE__ZEEK_CONN_PATH=/var/log/zeek/conn.log
IDS_SOURCE__ZEEK_DNS_PATH=/var/log/zeek/dns.log
IDS_SOURCE__ENDPOINT_AUTH_PATH=/data/input/endpoint-auth.jsonl
IDS_SOURCE__FOLLOW=true
IDS_SOURCE__FROM_BEGINNING=false

IDS_OPENSEARCH__ENABLED=true
IDS_OPENSEARCH__HOSTS=["http://opensearch:9200"]
IDS_OPENSEARCH__VERIFY_CERTS=false
IDS_OPENSEARCH__DEAD_LETTER_PATH=data/output/opensearch-dead-letter.jsonl
# For secured clusters, set both values through your secret manager:
# IDS_OPENSEARCH__USERNAME=telemetry_writer
# IDS_OPENSEARCH__PASSWORD=replace-me
IDS_OPENSEARCH__AUTH_INDEX_PATTERN=logs-endpoint.events.authentication-*

IDS_OUTPUT__INCLUDE_NORMALIZED_EVENTS=false
IDS_OUTPUT__INCLUDE_METRIC_SNAPSHOTS=true
IDS_METRICS__ENABLED=true
IDS_METRICS__BIND_HOST=0.0.0.0
IDS_METRICS__PORT=9108

# Detector tuning examples
IDS_CORRELATION__BEACON__MIN_EVENTS=8
IDS_CORRELATION__BEACON__WINDOW_SECONDS=900
IDS_CORRELATION__DNS_TUNNEL__MIN_QUERIES=12
IDS_CORRELATION__DNS_TUNNEL__WINDOW_SECONDS=300
